# URL of the deployed Google Apps Script web app that appends form
# submissions to a Google Sheet. See README.md for setup steps.
# Interim solution until the client's workflow management system is connected.
GOOGLE_SHEET_WEBHOOK_URL=

# Resend API key, used to send a confirmation email to the person who
# submitted the form and a notification email to redborincana@fundacionborincana.org.
# See README.md for setup steps. Requires the redborincana.org domain to be
# verified in Resend.
RESEND_API_KEY=
