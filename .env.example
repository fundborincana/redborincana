# URL of the deployed Google Apps Script web app that appends form
# submissions to a Google Sheet. See README.md for setup steps.
# Interim solution until the client's workflow management system is connected.
GOOGLE_SHEET_WEBHOOK_URL=

# Resend API key, used to send a confirmation email to the person who
# submitted the form. (The internal notice to the team no longer goes by email:
# it goes to Teams and Planner, see TEAMS_WEBHOOK_URL.)
# See README.md for setup steps. Requires the redborincana.org domain to be
# verified in Resend.
RESEND_API_KEY=

# (Opcional) URL del flujo de Teams («Workflows») que publica cada solicitud nueva en un chat o canal
# y, con los mismos datos «tarea» que usa WhatsApp, crea la tarjeta en Planner.
# Sin esta variable no se avisa a Teams. Ver README.md, sección «Aviso a Teams».
TEAMS_WEBHOOK_URL=
